# Chatwoot Production Environment Configuration
# Copy this file to .env.production and update values

# Rails Configuration
SECRET_KEY_BASE=CHANGE_ME_TO_A_SECURE_SECRET_KEY
FRONTEND_URL=https://your-domain.com
RAILS_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DATABASE=chatwoot_production

# Redis Configuration
REDIS_URL=redis://redis:6379/0
# If using Redis with password:
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0

# Enterprise Edition (Already bypassed)
CW_EDITION=ee
DEPLOYMENT_ENV=self-hosted

# Storage Configuration
ACTIVE_STORAGE_SERVICE=local
# For S3 or compatible storage:
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=us-east-1

# Email Configuration
MAILER_SENDER_EMAIL=Chatwoot <no-reply@your-domain.com>
# SMTP Configuration
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=your-domain.com

# Optional: Email Service (SendGrid, Mailgun, etc.)
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# Security & Authentication
ENABLE_ACCOUNT_SIGNUP=false
# For OAuth providers:
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# TWITTER_APP_ID=
# TWITTER_APP_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Integrations
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# OPENAI_API_KEY=

# Analytics & Monitoring
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=
# DATADOG_API_KEY=

# Optional Features
# IP_LOOKUP_API_KEY=
# MAPBOX_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Rate Limiting
# REDIS_RATE_LIMIT_URL=redis://redis:6379/1

# Job Queue Settings
# GOOD_JOB_EXECUTION_MODE=external
# GOOD_JOB_MAX_THREADS=5
# GOOD_JOB_POLL_INTERVAL=30