# Chatwoot configuration for connecting to external services via host.docker.internal
SECRET_KEY_BASE=3c6b50ffd14e4d206a777342d7a8606e4996a9b761eb9ad0ed81d3a49eaa39bf82d7e2a4a70de573eae1b86e2ab869c7a24d0fc3dc50f2620bbaa54b87955ee0
FRONTEND_URL=http://localhost:3000
RAILS_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5

# PostgreSQL - Connect to host or external container
# Use host.docker.internal to connect to services on the host machine
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=28d6f8da48cf9cbaf8ab768475d64242598325ac232f4638
POSTGRES_DATABASE=chatwoot_production

# Redis - Connect to host or external container
# If Redis requires password, include it in the URL
REDIS_URL=redis://:97d808d2b192117ecec966e85056117f@host.docker.internal:6379/0
REDIS_PASSWORD=97d808d2b192117ecec966e85056117f

# Alternative Redis configuration without password:
# REDIS_URL=redis://host.docker.internal:6379/0

# Storage
ACTIVE_STORAGE_SERVICE=local

# If using MinIO on host:
# STORAGE_BUCKET_NAME=chatwoot
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=535fbe7e70a6d09af10578ddf41d491a
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://host.docker.internal:9000
# STORAGE_FORCE_PATH_STYLE=true

# Logging
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Signups
ENABLE_ACCOUNT_SIGNUP=true

# Mailer
MAILER_SENDER_EMAIL=Chatwoot <accounts@chatwoot.local>

# SMTP via MailHog on host
SMTP_ADDRESS=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false

# Enterprise bypass activation
CW_EDITION=ee
DEPLOYMENT_ENV=self-hosted