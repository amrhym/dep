# Chatwoot selfhost env - generated 2025-09-19T06:03:46Z
SECRET_KEY_BASE=3c6b50ffd14e4d206a777342d7a8606e4996a9b761eb9ad0ed81d3a49eaa39bf82d7e2a4a70de573eae1b86e2ab869c7a24d0fc3dc50f2620bbaa54b87955ee0
FRONTEND_URL=http://localhost:3000
RAILS_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5
# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=28d6f8da48cf9cbaf8ab768475d64242598325ac232f4638
POSTGRES_DATABASE=chatwoot_production
# Redis - No password for external Redis
REDIS_URL=redis://redis:6379/0
# If your Redis requires a password, use:
# REDIS_URL=redis://:your_password@host.docker.internal:6379/0
REDIS_PASSWORD=
# Storage - Minio (S3 compatible)
ACTIVE_STORAGE_SERVICE=local
# STORAGE_BUCKET_NAME=chatwoot
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=535fbe7e70a6d09af10578ddf41d491a
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_FORCE_PATH_STYLE=true
# Logging
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Signups
ENABLE_ACCOUNT_SIGNUP=true

# Mailer (optional)
MAILER_SENDER_EMAIL=Chatwoot <accounts@chatwoot.local>

# Rack::Attack - whitelist local IPs and relax widget throttles for local dev
RACK_ATTACK_ALLOWED_IPS=172.24.0.1,127.0.0.1,::1
ENABLE_RACK_ATTACK_WIDGET_API=false

# SMTP via MailHog
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
